rules_version = '2';
// قواعد Firestore النهائية — عيادة المراعي البيطرية
// الدكتور = مستخدم Email/Password يوجد له مستند admins/{uid} (يُنشأ يدويًا من الـ Console فقط).
// العملاء = مستخدمون مجهولون (Anonymous) لا يملكون أي صلاحية إلا إنشاء طلب وقراءة طلباتهم هم فقط.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isDoctor() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isStr(v, max) { return v is string && v.size() <= max; }
    function optStr(d, k, max) { return !(k in d) || isStr(d[k], max); }

    // admins: القراءة لصاحب الـ UID فقط، والكتابة ممنوعة من التطبيق (تتم من الـ Console)
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // سجلات العيادة: الدكتور فقط.
    // rev لازم يزيد بمقدار 1 بالضبط: لو جهاز تاني كتب في نفس اللحظة الكتابة بتترفض (لا كتابة فوق تعديل أحدث بصمت).
    function validRecord(id) {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'rev', 'updatedAt'])
        && d.id == id
        && d.rev is int
        && d.rev == (resource == null ? 1 : resource.data.rev + 1)
        && d.updatedAt is number
        && (!('_deleted' in d) || d._deleted is bool)
        && d.keys().size() <= 60;
    }

    match /patients/{id}     { allow read, delete: if isDoctor(); allow create, update: if isDoctor() && validRecord(id); }
    match /appointments/{id} { allow read, delete: if isDoctor(); allow create, update: if isDoctor() && validRecord(id); }
    match /finance/{id}      { allow read, delete: if isDoctor(); allow create, update: if isDoctor() && validRecord(id); }
    match /chicks/{id}       { allow read, delete: if isDoctor(); allow create, update: if isDoctor() && validRecord(id); }
    match /batches/{id}      { allow read, delete: if isDoctor(); allow create, update: if isDoctor() && validRecord(id); }
    match /shortages/{id}    { allow read, delete: if isDoctor(); allow create, update: if isDoctor() && validRecord(id); }
    match /orders/{id}       { allow read, delete: if isDoctor(); allow create, update: if isDoctor() && validRecord(id); }
    match /companies/{id}    { allow read, delete: if isDoctor(); allow create, update: if isDoctor() && validRecord(id); }
    match /debts/{id}        { allow read, delete: if isDoctor(); allow create, update: if isDoctor() && validRecord(id); }
    match /manualRequests/{id} { allow read, delete: if isDoctor(); allow create, update: if isDoctor() && validRecord(id); }
    match /meta/{id}         { allow read, delete: if isDoctor(); allow create, update: if isDoctor() && validRecord(id); }

    // صور السجلات (Base64 مضغوطة) في مستندات منفصلة حتى لا يتضخم مستند السجل نفسه
    match /images/{id} {
      allow read, delete: if isDoctor();
      allow create, update: if isDoctor()
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && isStr(request.resource.data.data, 900000)
        && request.resource.data.data.matches('^data:image/(jpeg|png|webp);base64,.*')
        && request.resource.data.updatedAt is number;
    }

    // المستند القديم (التصميم السابق): قراءة فقط للدكتور لأجل الترحيل، ولا أحد يكتب فيه بعد الآن
    match /clinic/{id} {
      allow read: if isDoctor();
      allow write: if false;
    }

    // صفحة العملاء العامة
    match /public/{id} {
      allow get: if id == 'page';
      allow list: if false;
      allow create, update: if isDoctor() && id == 'page'
        && request.resource.data.keys().hasOnly(['title', 'welcome', 'sub', 'pageLabel', 'pageUrl', 'imageIds', 'images', 'logo', 'at'])
        && optStr(request.resource.data, 'title', 200)
        && optStr(request.resource.data, 'welcome', 1000)
        && optStr(request.resource.data, 'sub', 500)
        && optStr(request.resource.data, 'pageLabel', 100)
        && (!('pageUrl' in request.resource.data)
            || (isStr(request.resource.data.pageUrl, 500) && request.resource.data.pageUrl.matches('^(https?://[^ <>"]*)?$')))
        && (!('imageIds' in request.resource.data)
            || (request.resource.data.imageIds is list && request.resource.data.imageIds.size() <= 6))
        && (!('images' in request.resource.data)
            || (request.resource.data.images is list && request.resource.data.images.size() <= 6))
        && optStr(request.resource.data, 'logo', 400000);
      allow delete: if false;
    }

    match /publicImages/{id} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isDoctor()
        && request.resource.data.keys().hasOnly(['data', 'at'])
        && isStr(request.resource.data.data, 900000)
        && request.resource.data.data.matches('^data:image/(jpeg|png|webp);base64,.*')
        && request.resource.data.at is number;
      allow delete: if isDoctor();
    }

    // طلبات العملاء
    match /requests/{id} {
      // إنشاء: مستخدم مسجل (مجهول) فقط، والطلب يُنسب لصاحبه ownerUid ولا يقدر يحدد حالة أو رد
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['name', 'phone', 'type', 'details', 'status', 'createdAt', 'ownerUid'])
        && request.resource.data.keys().hasOnly(['name', 'phone', 'animalType', 'animalName', 'type', 'date', 'time', 'address', 'details', 'status', 'createdAt', 'ownerUid'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'جديد'
        && request.resource.data.createdAt == request.time
        && isStr(request.resource.data.name, 100) && request.resource.data.name.size() >= 2
        && request.resource.data.phone is string && request.resource.data.phone.matches('^01[0125][0-9]{8}$')
        && request.resource.data.type in ['حجز كشف بالعيادة', 'متابعة', 'تطعيم', 'زيارة منزلية', 'زيارة مزرعة', 'استفسار']
        && (!('animalType' in request.resource.data)
            || request.resource.data.animalType in ['قط', 'كلب', 'أرنب', 'طيور', 'أبقار', 'جاموس', 'أغنام', 'ماعز', 'خيول', 'أخرى'])
        && optStr(request.resource.data, 'animalName', 100)
        && (!('date' in request.resource.data) || request.resource.data.date == '' || (isStr(request.resource.data.date, 10) && request.resource.data.date.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')))
        && (!('time' in request.resource.data) || request.resource.data.time == '' || (isStr(request.resource.data.time, 5) && request.resource.data.time.matches('^[0-2][0-9]:[0-5][0-9]$')))
        && optStr(request.resource.data, 'address', 300)
        && isStr(request.resource.data.details, 1500) && request.resource.data.details.size() >= 1;

      // قراءة: الدكتور، أو صاحب الطلب فقط. لا توجد قراءة عامة.
      allow get: if isDoctor() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow list: if isDoctor() || (signedIn() && resource.data.ownerUid == request.auth.uid);

      // تعديل: الدكتور فقط وفي حقول الحالة والرد فقط
      allow update: if isDoctor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reply', 'repliedAt'])
        && request.resource.data.status in ['جديد', 'تم التواصل', 'تم التأكيد', 'تم الرد']
        && (!('reply' in request.resource.data) || isStr(request.resource.data.reply, 1500))
        && (!('repliedAt' in request.resource.data) || request.resource.data.repliedAt is number);

      allow delete: if isDoctor();
    }

    // أي مسار آخر: ممنوع
    match /{document=**} { allow read, write: if false; }
  }
}
